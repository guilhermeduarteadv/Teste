Options +FollowSymLinks -Indexes

# Block access to sensitive files
<FilesMatch "\.(env|lock|log|sql|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to app internals
    RewriteRule ^(app|config|core|database|storage|logs)/ - [F,L]

    # Route everything through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Fallback when mod_rewrite is not loaded (FallbackResource requires Apache 2.2.16+)
# NOTE: update the path below if your installation folder changes
<IfModule !mod_rewrite.c>
    FallbackResource /teste/public/index.php
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
